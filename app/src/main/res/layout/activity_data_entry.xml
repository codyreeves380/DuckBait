<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/duckbait_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="DuckBait"
            android:textColor="@color/duckbait_text"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="6dp"
            android:text="Case Info"
            android:textColor="@color/duckbait_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/input_defendant"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:backgroundTint="@color/duckbait_primary"
            android:hint="Defendant"
            android:textColor="@color/duckbait_text"
            android:textColorHint="@color/duckbait_hint"
            android:inputType="textPersonName" />
        <CheckBox
            android:id="@+id/save_defendant"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Save Defendant"
            android:textColor="@color/duckbait_text" />

        <EditText
            android:id="@+id/input_causeno"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:backgroundTint="@color/duckbait_primary"
            android:hint="Cause No."
            android:textColor="@color/duckbait_text"
            android:textColorHint="@color/duckbait_hint"
            android:inputType="text" />
        <CheckBox
            android:id="@+id/save_causeno"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Save Cause No."
            android:textColor="@color/duckbait_text" />

        <EditText
            android:id="@+id/input_defid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:backgroundTint="@color/duckbait_primary"
            android:hint="Defendant ID"
            android:textColor="@color/duckbait_text"
            android:textColorHint="@color/duckbait_hint"
            android:inputType="text" />
        <CheckBox
            android:id="@+id/save_defid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Save Defendant ID"
            android:textColor="@color/duckbait_text" />

        <EditText
            android:id="@+id/input_judge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:backgroundTint="@color/duckbait_primary"
            android:hint="Judge"
            android:textColor="@color/duckbait_text"
            android:textColorHint="@color/duckbait_hint"
            android:inputType="textPersonName" />
        <CheckBox
            android:id="@+id/save_judge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Save Judge"
            android:textColor="@color/duckbait_text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp"
            android:text="Requirement"
            android:textColor="@color/duckbait_text"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/group_requirement"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/option_not_required"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Not Required"
                android:textColor="@color/duckbait_text" />

            <RadioButton
                android:id="@+id/option_requirement"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Requirement"
                android:textColor="@color/duckbait_text" />
        </RadioGroup>


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="6dp"
            android:text="Your Info"
            android:textColor="@color/duckbait_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/input_compliance_officer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:backgroundTint="@color/duckbait_primary"
            android:hint="Compliance Officer"
            android:textColor="@color/duckbait_text"
            android:textColorHint="@color/duckbait_hint"
            android:inputType="textPersonName" />
        <CheckBox
            android:id="@+id/save_compliance_officer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Save Compliance Officer"
            android:textColor="@color/duckbait_text" />

        <EditText
            android:id="@+id/input_badge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:backgroundTint="@color/duckbait_primary"
            android:hint="Badge"
            android:textColor="@color/duckbait_text"
            android:textColorHint="@color/duckbait_hint"
            android:inputType="text" />
        <CheckBox
            android:id="@+id/save_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Save Badge"
            android:textColor="@color/duckbait_text" />

        <EditText
            android:id="@+id/input_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:backgroundTint="@color/duckbait_primary"
            android:hint="Email"
            android:textColor="@color/duckbait_text"
            android:textColorHint="@color/duckbait_hint"
            android:inputType="textEmailAddress" />
        <CheckBox
            android:id="@+id/save_email"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Save Email"
            android:textColor="@color/duckbait_text" />

        <EditText
            android:id="@+id/input_phone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:backgroundTint="@color/duckbait_primary"
            android:hint="Phone"
            android:textColor="@color/duckbait_text"
            android:textColorHint="@color/duckbait_hint"
            android:inputType="phone" />
        <CheckBox
            android:id="@+id/save_phone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Save Phone"
            android:textColor="@color/duckbait_text" />


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="6dp"
            android:text="Pay Amounts"
            android:textColor="@color/duckbait_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/input_gps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:backgroundTint="@color/duckbait_primary"
            android:hint="GPS"
            android:textColor="@color/duckbait_text"
            android:textColorHint="@color/duckbait_hint"
            android:inputType="text" />
        <CheckBox
            android:id="@+id/save_gps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Save GPS"
            android:textColor="@color/duckbait_text" />

        <EditText
            android:id="@+id/input_program"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:backgroundTint="@color/duckbait_primary"
            android:hint="Program"
            android:textColor="@color/duckbait_text"
            android:textColorHint="@color/duckbait_hint"
            android:inputType="text" />
        <CheckBox
            android:id="@+id/save_program"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Save Program"
            android:textColor="@color/duckbait_text" />

        <EditText
            android:id="@+id/input_tax"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:backgroundTint="@color/duckbait_primary"
            android:hint="Tax"
            android:textColor="@color/duckbait_text"
            android:textColorHint="@color/duckbait_hint"
            android:inputType="text" />
        <CheckBox
            android:id="@+id/save_tax"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Save Tax"
            android:textColor="@color/duckbait_text" />

        <EditText
            android:id="@+id/input_deposit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:backgroundTint="@color/duckbait_primary"
            android:hint="Deposit"
            android:textColor="@color/duckbait_text"
            android:textColorHint="@color/duckbait_hint"
            android:inputType="numberDecimal" />
        <CheckBox
            android:id="@+id/save_deposit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Save Deposit"
            android:textColor="@color/duckbait_text" />


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="6dp"
            android:text="Dates"
            android:textColor="@color/duckbait_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/input_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:backgroundTint="@color/duckbait_primary"
            android:hint="Date"
            android:textColor="@color/duckbait_text"
            android:textColorHint="@color/duckbait_hint"
            android:inputType="textCapSentences" />
        <CheckBox
            android:id="@+id/save_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Save Date"
            android:textColor="@color/duckbait_text" />

        <EditText
            android:id="@+id/input_day"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:backgroundTint="@color/duckbait_primary"
            android:hint="Day"
            android:textColor="@color/duckbait_text"
            android:textColorHint="@color/duckbait_hint"
            android:inputType="text" />
        <CheckBox
            android:id="@+id/save_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Save Day"
            android:textColor="@color/duckbait_text" />

        <EditText
            android:id="@+id/input_month"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:backgroundTint="@color/duckbait_primary"
            android:hint="Month"
            android:textColor="@color/duckbait_text"
            android:textColorHint="@color/duckbait_hint"
            android:inputType="text" />
        <CheckBox
            android:id="@+id/save_month"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Save Month"
            android:textColor="@color/duckbait_text" />

        <EditText
            android:id="@+id/input_year"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:backgroundTint="@color/duckbait_primary"
            android:hint="Year"
            android:textColor="@color/duckbait_text"
            android:textColorHint="@color/duckbait_hint"
            android:inputType="number" />
        <CheckBox
            android:id="@+id/save_year"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Save Year"
            android:textColor="@color/duckbait_text" />


        <Button
            android:id="@+id/btn_select_file"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/duckbait_primary"
            android:text="Select DOCX Template"
            android:textColor="@color/duckbait_background" />

        <TextView
            android:id="@+id/txt_selected_file"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:text="No template selected"
            android:textColor="@color/duckbait_text" />

        <Button
            android:id="@+id/btn_generate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/duckbait_primary"
            android:text="Generate Document"
            android:textColor="@color/duckbait_background" />

        <TextView
            android:id="@+id/txt_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:text="Status: Complete the fields, then continue."
            android:textColor="@color/duckbait_text" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">
            <Button
                android:id="@+id/btn_data_back"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Back" />
            <Button
                android:id="@+id/btn_data_next"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="Next" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>

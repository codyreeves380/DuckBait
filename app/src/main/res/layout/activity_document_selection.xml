<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/duckbait_background">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PTS Documents"
            android:textColor="@color/duckbait_text"
            android:textSize="26sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="State"
            android:textColor="@color/duckbait_text"
            android:textStyle="bold" />
        <Spinner
            android:id="@+id/spinner_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="County / Document"
            android:textColor="@color/duckbait_text"
            android:textStyle="bold" />
        <Spinner
            android:id="@+id/spinner_county"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:enabled="false" />
        <TextView
            android:id="@+id/txt_catalog_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="No preset documents are available in this build. Update the app or check the preset catalog."
            android:textColor="@color/duckbait_hint"
            android:visibility="gone" />
        <TextView
            android:id="@+id/txt_selection_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/duckbait_text" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">
            <Button
                android:id="@+id/btn_selection_back"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Back" />
            <Button
                android:id="@+id/btn_selection_next"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="Next"
                android:enabled="false" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/duckbait_background">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="36dp"
        android:text="DuckBait"
        android:textColor="@color/duckbait_text"
        android:textSize="32sp"
        android:textStyle="bold" />
    <Button
        android:id="@+id/btn_open_pts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="PTS"
        android:backgroundTint="@color/duckbait_primary"
        android:textColor="@color/duckbait_background" />
    <Button
        android:id="@+id/btn_coming_soon"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Coming soon"
        android:enabled="false" />
    <Button
        android:id="@+id/btn_settings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="⚙  Coming soon"
        android:enabled="false" />
</LinearLayout>